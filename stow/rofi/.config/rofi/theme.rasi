@import "colors"

* {
    font: "sans-serif 11";
    background-color: transparent;
    text-color: @fg;
}

window {
    location: center;
    width: 560px;
    background-color: @bg;
    border: 1px;
    border-color: @accent;
    border-radius: 0;
}

mainbox {
    padding: 16px 24px;
    spacing: 8px;
    children: [inputbar, listview];
}

inputbar {
    padding: 8px;
    spacing: 8px;
    children: [prompt, entry];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search";
    placeholder-color: @muted;
}

listview {
    lines: 8;
    columns: 1;
    scrollbar: false;
    fixed-height: false;
    spacing: 2px;
}

element {
    padding: 8px;
    spacing: 8px;
    border-radius: 0;
}

element selected.normal {
    background-color: @selection;
}

element-icon {
    size: 1.5em;
}

element-text {
    vertical-align: 0.5;
}

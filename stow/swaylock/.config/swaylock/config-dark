# Calcite dark palette, flat/square to match the waybar theme. `config` is a symlink
# to config-dark/config-light flipped by the waybar theme switcher (swaylock has no
# include, so the two files differ only in the colors).
daemonize
ignore-empty-password
show-failed-attempts
indicator-idle-visible
indicator-radius=70
indicator-thickness=6
font=sans-serif
font-size=20

color=282529
inside-color=282529
inside-clear-color=282529
inside-caps-lock-color=282529
inside-ver-color=282529
inside-wrong-color=282529
ring-color=8a8692
ring-clear-color=d7b45a
ring-caps-lock-color=d7b45a
ring-ver-color=b9a3f0
ring-wrong-color=e07a72
key-hl-color=b9a3f0
bs-hl-color=e07a72
caps-lock-key-hl-color=d7b45a
caps-lock-bs-hl-color=e07a72
separator-color=282529
line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
text-color=dcd9e1
text-clear-color=dcd9e1
text-caps-lock-color=dcd9e1
text-ver-color=dcd9e1
text-wrong-color=dcd9e1

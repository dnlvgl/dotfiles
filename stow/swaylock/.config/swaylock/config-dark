# Calcite dark palette, flat/square to match the waybar theme. `config` is a symlink
# to config-dark/config-light flipped by the waybar theme switcher (swaylock has no
# include, so the two files differ only in the colors).
daemonize
ignore-empty-password
show-failed-attempts
indicator-idle-visible
indicator-radius=70
indicator-thickness=6
font=sans-serif
font-size=20

color=222226
inside-color=222226
inside-clear-color=222226
inside-caps-lock-color=222226
inside-ver-color=222226
inside-wrong-color=222226
ring-color=6a6a6a
ring-clear-color=c8a830
ring-caps-lock-color=c8a830
ring-ver-color=bda7f0
ring-wrong-color=b85450
key-hl-color=bda7f0
bs-hl-color=b85450
caps-lock-key-hl-color=c8a830
caps-lock-bs-hl-color=b85450
separator-color=222226
line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
text-color=f1f1f1
text-clear-color=f1f1f1
text-caps-lock-color=f1f1f1
text-ver-color=f1f1f1
text-wrong-color=f1f1f1

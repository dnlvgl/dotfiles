# Calcite light palette, flat/square to match the waybar theme. `config` is a symlink
# to config-dark/config-light flipped by the waybar theme switcher (swaylock has no
# include, so the two files differ only in the colors).
daemonize
ignore-empty-password
show-failed-attempts
indicator-idle-visible
indicator-radius=70
indicator-thickness=6
font=sans-serif
font-size=20

color=f7f6f9
inside-color=f7f6f9
inside-clear-color=f7f6f9
inside-caps-lock-color=f7f6f9
inside-ver-color=f7f6f9
inside-wrong-color=f7f6f9
ring-color=74707c
ring-clear-color=86650f
ring-caps-lock-color=86650f
ring-ver-color=745ba8
ring-wrong-color=a83b38
key-hl-color=745ba8
bs-hl-color=a83b38
caps-lock-key-hl-color=86650f
caps-lock-bs-hl-color=a83b38
separator-color=f7f6f9
line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
text-color=34313a
text-clear-color=34313a
text-caps-lock-color=34313a
text-ver-color=34313a
text-wrong-color=34313a

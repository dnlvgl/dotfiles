# Started with `swayidle -w` from niri. Locks after 5 minutes idle unless the
# waybar caffeine toggle is on, on `loginctl lock-session`, and before suspend.
timeout 300 '~/.config/waybar/scripts/caffeine.sh status || ~/.config/gtklock/lock.sh &'
lock '~/.config/gtklock/lock.sh &'
before-sleep '~/.config/gtklock/lock.sh'

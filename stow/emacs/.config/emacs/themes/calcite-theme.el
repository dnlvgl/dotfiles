;;; calcite-theme.el --- Shared definitions for calcite themes -*- lexical-binding: t; -*-

;; This file contains the shared color and face definitions used by
;; both calcite-light and calcite-dark themes.

;; Colors are named by role, not hue. Neutrals carry a faint purple tint
;; so everything reads as one family; red/green/yellow are only used for
;; meaning (errors, success, warnings, diffs).
(defconst calcite-themes-colors
  '((bg          "#f7f6f9" "#282529")
    (bg-alt      "#eae8ee" "#312d32")
    (bg-sel      "#ddd6ea" "#433a52")
    (border      "#cfcbd6" "#423d43")
    (fg-dim      "#74707c" "#8a8692")
    (fg          "#34313a" "#dcd9e1")
    (accent      "#745ba8" "#b9a3f0")
    (accent-soft "#e6dff4" "#372f42")
    (red         "#a83b38" "#e07a72")
    (green       "#2e7643" "#7cc48c")
    (yellow      "#86650f" "#d7b45a")
    (blue        "#4d5fa8" "#8e9ee0")
    (cyan        "#31707a" "#7cb8c0")
    (diff-add-bg "#e1f0e3" "#273a2d")
    (diff-add-hl "#bfe2c6" "#33573e")
    (diff-del-bg "#f6e0e0" "#44292d")
    (diff-del-hl "#ecbcbc" "#653439")
    ;; ANSI black/white swap roles between variants, so they get their own entries.
    (ansi-black  "#34313a" "#423d43")
    (ansi-white  "#eae8ee" "#dcd9e1")
    (ansi-bright-white "#f7f6f9" "#dcd9e1"))
  "Color palette for calcite themes.
Each color is a list: (name light-value dark-value).")

(defun calcite-themes-get-colors (variant)
  "Get color alist for VARIANT (0 for light, 1 for dark)."
  (mapcar (lambda (color-def)
            (cons (car color-def) (nth (1+ variant) color-def)))
          calcite-themes-colors))

(defun calcite-themes-apply (theme-name colors)
  "Apply THEME-NAME with COLORS palette.
COLORS is an alist keyed by the names in `calcite-themes-colors'."
  (let ((bg (alist-get 'bg colors))
        (bg-alt (alist-get 'bg-alt colors))
        (bg-sel (alist-get 'bg-sel colors))

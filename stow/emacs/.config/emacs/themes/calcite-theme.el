        (accent-soft (alist-get 'accent-soft colors))
        (red (alist-get 'red colors))
        (green (alist-get 'green colors))
        (yellow (alist-get 'yellow colors))
        (blue (alist-get 'blue colors))
        (cyan (alist-get 'cyan colors))
        (diff-add-bg (alist-get 'diff-add-bg colors))
        (diff-add-hl (alist-get 'diff-add-hl colors))
        (diff-del-bg (alist-get 'diff-del-bg colors))

# Calcite syntax colors. Only named ANSI colors, so fish follows the kitty/foot
# palette in light and dark: commands bold, strings purple, the rest plain or dim.
set --global fish_color_normal normal
set --global fish_color_command normal --bold
set --global fish_color_keyword normal --bold
set --global fish_color_param normal
set --global fish_color_option normal
set --global fish_color_quote magenta
set --global fish_color_escape magenta
set --global fish_color_comment brblack
set --global fish_color_autosuggestion brblack
set --global fish_color_operator brblack
set --global fish_color_redirection brblack
set --global fish_color_end brblack
set --global fish_color_error red
set --global fish_color_cancel --reverse
set --global fish_color_valid_path --underline
set --global fish_color_history_current --bold
set --global fish_color_search_match --bold --underline
set --global fish_color_selection --reverse
set --global fish_color_cwd magenta
set --global fish_color_cwd_root red
set --global fish_color_user normal
set --global fish_color_host normal
set --global fish_color_host_remote magenta
set --global fish_color_status red
set --global fish_pager_color_completion normal
set --global fish_pager_color_description brblack
set --global fish_pager_color_prefix normal --bold --underline
set --global fish_pager_color_progress brblack
set --global fish_pager_color_selected_background --reverse
